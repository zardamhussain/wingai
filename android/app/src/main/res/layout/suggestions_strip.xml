<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:animateLayoutChanges="true"
        android:id="@+id/suggestions_strip_wrapper"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false">
        <!-- SwiftKey Level 2 Left: 40dp wrapper containing 28dp circular Chevron button (`rb0/y0` + `rb0/a1`) -->
        <com.wingai.keyboard.ui.WingAiChevronToggleView
            android:id="@+id/wingai_chevron_toggle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />
        <!-- Legacy HeliBoard expand key hidden so Level 2 stays a clean 3-slot candidate bar -->
        <ImageButton
            android:id="@+id/suggestions_strip_toolbar_key"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:background="@drawable/toolbar_expand_key_background"
            style="?attr/suggestionWordStyle"
            android:contentDescription="@string/more_keys_strip_description" />
        <HorizontalScrollView
            android:id="@+id/toolbar_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scrollbarThumbHorizontal="@color/toolbar_scrollbar"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                style="?attr/suggestionWordStyle">
            </LinearLayout>
        </HorizontalScrollView>
        <!-- SwiftKey Level 2 Center: 3 equal-width suggestion slots (`SequentialCandidateBarLayout`) -->
        <LinearLayout
            android:id="@+id/suggestions_strip"
            android:orientation="horizontal"
            android:maxWidth="100dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:hapticFeedbackEnabled="false"
            android:soundEffectsEnabled="false" />
        <LinearLayout
            android:id="@+id/pinned_keys"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:minWidth="0dp"
            style="?attr/suggestionWordStyle">
        </LinearLayout>
        <com.wingai.keyboard.ui.WingAiToolbarActionsView
            android:id="@+id/wingai_toolbar_actions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />
    </LinearLayout>
</merge>
